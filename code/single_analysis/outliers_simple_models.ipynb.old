{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Regression Models\n",
    "#\n",
    "#### 1st Model: y = ß_0 + ß_1 * score + ß_2_n * dummies + ß_n+1_m * score * dummies"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "# Add the parent directory (code/) to sys.path\n",
    "sys.path.append(str(Path().resolve().parent))\n",
    "from utils import (\n",
    "    load_data,\n",
    "    separate_df_by_scores,\n",
    "    simple_backward_regression,\n",
    "    model_summary,\n",
    "    plot_residual_diagnostics,\n",
    "    gaussian_yj_transform,\n",
    ")\n",
    "\n",
    "import pandas as pd\n",
    "from collections import Counter\n",
    "import time"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Loading the data\n",
    "#\n",
    "### First we start with basic cleaned data (with outliers)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "datasets = {}\n",
    "for outlier_methods in [\"IQR\", \"IF\", \"SVM\", \"LOF\"]:\n",
    "    file_name = \"Small Data future\"\n",
    "    data_path = f\"../data/cleaned/multiple_analysis/outliers/{file_name} - {outlier_methods}.csv\"\n",
    "\n",
    "    # Read the CSV file\n",
    "    df = load_data(data_path)\n",
    "    df.drop(columns=[\"market_cap\", \"volume\"], inplace=True)\n",
    "\n",
    "    # Adding dummy variables\n",
    "    df = pd.get_dummies(df, columns=[\"sector\", \"region\"])\n",
    "\n",
    "    datasets[outlier_methods] = df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 1st Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Explanatory variables:\n",
    "scores = [\"quality\", \"growth\", \"value\", \"dividend\"]\n",
    "\n",
    "dummies = [col for col in df.columns if col.startswith((\"sector_\", \"region_\"))]\n",
    "\n",
    "# Dependent variables:\n",
    "profits = [\n",
    "    \"profit_1m\",\n",
    "    \"profit_3m\",\n",
    "    \"profit_6m\",\n",
    "    \"profit_1y\",\n",
    "    \"profit_2y\",\n",
    "    \"profit_5y\",\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "start_time = time.perf_counter()\n",
    "model_count = 0\n",
    "method_summaries = {}\n",
    "for outlier_method, dataset in datasets.items():\n",
    "\n",
    "    dataframes = separate_df_by_scores(df)\n",
    "    reg_model_summaries = []\n",
    "\n",
    "    for score in scores:\n",
    "        score_df = dataframes[score]\n",
    "\n",
    "        # Add interaction terms\n",
    "        for dummy in dummies:\n",
    "            score_df[f\"{score}_{dummy}\"] = score_df[score] * score_df[dummy]\n",
    "\n",
    "        # For each profit, we perform backward elimination\n",
    "        for profit in profits:\n",
    "\n",
    "            X_cols = (\n",
    "                [score] + dummies + [f\"{score}_{dummy}\" for dummy in dummies]\n",
    "            )\n",
    "            X = score_df[X_cols].astype(float)\n",
    "            y = score_df[profit].astype(float)\n",
    "\n",
    "            summary = simple_backward_regression(X, y)\n",
    "            summary[\"score_type\"] = score\n",
    "            summary[\"profit\"] = profit\n",
    "\n",
    "            # Collect summary info\n",
    "            reg_model_summaries.append(summary)\n",
    "            model_count += 1\n",
    "\n",
    "    # Create and display summary DataFrame\n",
    "    summary_df = pd.DataFrame(reg_model_summaries)\n",
    "    summary_df = summary_df.sort_values([\"score_type\"]).reset_index(drop=True)\n",
    "    method_summaries[outlier_method] = summary_df\n",
    "\n",
    "end_time = time.perf_counter()\n",
    "total_time = end_time - start_time\n",
    "avg_time = total_time / model_count\n",
    "print(f\"\\nTotal time: {total_time:.2f} seconds\")\n",
    "print(f\"Average time per model: {avg_time:.2f} seconds\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Analyzing the models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "all_removed = []\n",
    "for summary in method_summaries.values():\n",
    "    for feat in summary[\"removed_features\"]:\n",
    "        all_removed.append(feat)\n",
    "\n",
    "# Count frequency of each removed feature\n",
    "removed_counts = Counter([item for sublist in all_removed for item in sublist])\n",
    "\n",
    "# Convert to DataFrame for easier analysis\n",
    "removed_df = pd.DataFrame(\n",
    "    removed_counts.items(), columns=[\"feature\", \"times_removed\"]\n",
    ")\n",
    "removed_df = removed_df.sort_values(\n",
    "    by=\"times_removed\", ascending=False\n",
    ").reset_index(drop=True)\n",
    "\n",
    "# Display top 10 most dropped features\n",
    "print(\"\\n===== Most Frequently Removed Features =====\")\n",
    "print(removed_df.head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for outlier_method, summary_df in method_summaries.items():\n",
    "    export_path = f\"first_model/{outlier_method}_models_summary.png\"\n",
    "    model_summary(summary_df, profits, export_path)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Residues Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for outlier_method, summary_df in method_summaries.items():\n",
    "\n",
    "    # === Loop through all models and plot residual diagnostics ===\n",
    "    for summary in reg_model_summaries:\n",
    "        export_path = f\"first_model/{outlier_method}/{summary['score_type']}_{summary['profit']}_residuals.png\"\n",
    "\n",
    "        plot_residual_diagnostics(\n",
    "            summary[\"residuals\"],\n",
    "            summary[\"y_pred\"],\n",
    "            title=f\"{summary['score_type']} - {summary['profit']}\",\n",
    "            export_path=export_path,\n",
    "        )"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Applying a Gaussian transformation to profits"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "start_time = time.perf_counter()\n",
    "model_count = 0\n",
    "method_summaries = {}\n",
    "for outlier_method, dataset in datasets.items():\n",
    "\n",
    "    dataframes = separate_df_by_scores(df)\n",
    "    reg_model_summaries = []\n",
    "\n",
    "    for score in scores:\n",
    "        score_df = dataframes[score]\n",
    "\n",
    "        # Add interaction terms\n",
    "        for dummy in dummies:\n",
    "            score_df[f\"{score}_{dummy}\"] = score_df[score] * score_df[dummy]\n",
    "\n",
    "        for profit in profits:\n",
    "\n",
    "            X_cols = (\n",
    "                [score] + dummies + [f\"{score}_{dummy}\" for dummy in dummies]\n",
    "            )\n",
    "            X = score_df[X_cols].astype(float)\n",
    "            y = gaussian_yj_transform(score_df[profit])\n",
    "\n",
    "            summary = simple_backward_regression(X, y)\n",
    "            summary[\"score_type\"] = score\n",
    "            summary[\"profit\"] = profit\n",
    "\n",
    "            # Collect summary info\n",
    "            reg_model_summaries.append(summary)\n",
    "            model_count += 1\n",
    "\n",
    "    summary_df = pd.DataFrame(reg_model_summaries)\n",
    "    summary_df = summary_df.sort_values([\"score_type\"]).reset_index(drop=True)\n",
    "    method_summaries[outlier_method] = summary_df\n",
    "\n",
    "end_time = time.perf_counter()\n",
    "total_time = end_time - start_time\n",
    "avg_time = total_time / model_count\n",
    "print(f\"\\nTotal time: {total_time:.2f} seconds\")\n",
    "print(f\"Average time per model: {avg_time:.2f} seconds\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "all_removed = []\n",
    "for summary in method_summaries.values():\n",
    "    for feat in summary[\"removed_features\"]:\n",
    "        all_removed.append(feat)\n",
    "\n",
    "removed_counts = Counter([item for sublist in all_removed for item in sublist])\n",
    "\n",
    "removed_df = pd.DataFrame(\n",
    "    removed_counts.items(), columns=[\"feature\", \"times_removed\"]\n",
    ")\n",
    "removed_df = removed_df.sort_values(\n",
    "    by=\"times_removed\", ascending=False\n",
    ").reset_index(drop=True)\n",
    "\n",
    "print(\"\\n===== Most Frequently Removed Features =====\")\n",
    "print(removed_df.head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [],
   "source": [
    "for outlier_method, summary_df in method_summaries.items():\n",
    "    export_path = (\n",
    "        f\"second_model/{outlier_method}_models_summary - Gaussian.png\"\n",
    "    )\n",
    "    model_summary(summary_df, profits, export_path)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [],
   "source": [
    "for outlier_method, summary_df in method_summaries.items():\n",
    "    for summary in reg_model_summaries:\n",
    "        export_path = f\"second_model/{outlier_method}/{summary['score_type']}_{summary['profit']}_residuals.png\"\n",
    "\n",
    "        plot_residual_diagnostics(\n",
    "            summary[\"residuals\"],\n",
    "            summary[\"y_pred\"],\n",
    "            title=f\"{summary['score_type']} - {summary['profit']}\",\n",
    "            export_path=export_path,\n",
    "        )"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 2nd Model + Gaussian"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "start_time = time.perf_counter()\n",
    "model_count = 0\n",
    "method_summaries = {}\n",
    "for outlier_method, dataset in datasets.items():\n",
    "    reg_model_summaries = []\n",
    "\n",
    "    for score in scores:\n",
    "        score_df = dataframes[score]\n",
    "\n",
    "        # Add interaction terms\n",
    "        for dummy in dummies:\n",
    "            score_df[f\"{score}_{dummy}\"] = score_df[score] * score_df[dummy]\n",
    "\n",
    "        # Create rolling averages for each score type\n",
    "        for window in [3, 6, 12, 24]:  # 3m, 6m, 1y, 2y in months\n",
    "            score_df[f\"{score}_avg_{window}m\"] = score_df.groupby(\"ticker\")[\n",
    "                score\n",
    "            ].transform(\n",
    "                lambda x: x.rolling(window=window, min_periods=1).mean()\n",
    "            )\n",
    "\n",
    "        score_df.dropna(inplace=True)\n",
    "\n",
    "        for profit in profits:\n",
    "\n",
    "            window_cols = [\n",
    "                f\"{score}_avg_{window}m\" for window in [3, 6, 12, 24]\n",
    "            ]\n",
    "            window_cols_dummies = []\n",
    "            for window in [3, 6, 12, 24]:\n",
    "                for dummy in dummies:\n",
    "                    score_df[f\"{score}_avg_{window}m_{dummy}\"] = (\n",
    "                        score_df[f\"{score}_avg_{window}m\"] * score_df[dummy]\n",
    "                    )\n",
    "                    window_cols_dummies.append(\n",
    "                        f\"{score}_avg_{window}m_{dummy}\"\n",
    "                    )\n",
    "\n",
    "            X_cols = (\n",
    "                [score]\n",
    "                + dummies\n",
    "                + [f\"{score}_{dummy}\" for dummy in dummies]\n",
    "                + window_cols\n",
    "                + window_cols_dummies\n",
    "            )\n",
    "            X = score_df[X_cols].astype(float)\n",
    "            y = gaussian_yj_transform(score_df[profit])\n",
    "\n",
    "            summary = simple_backward_regression(X, y)\n",
    "            summary[\"score_type\"] = score\n",
    "            summary[\"profit\"] = profit\n",
    "\n",
    "            # Collect summary info\n",
    "            reg_model_summaries.append(summary)\n",
    "            model_count += 1\n",
    "\n",
    "    summary_df = pd.DataFrame(reg_model_summaries)\n",
    "    summary_df = summary_df.sort_values([\"score_type\"]).reset_index(drop=True)\n",
    "    method_summaries[outlier_method] = summary_df\n",
    "\n",
    "end_time = time.perf_counter()\n",
    "total_time = end_time - start_time\n",
    "avg_time = total_time / model_count\n",
    "print(f\"\\nTotal time: {total_time:.2f} seconds\")\n",
    "print(f\"Average time per model: {avg_time:.2f} seconds\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "all_removed = []\n",
    "for summary in method_summaries.values():\n",
    "    for feat in summary[\"removed_features\"]:\n",
    "        all_removed.append(feat)\n",
    "\n",
    "removed_counts = Counter([item for sublist in all_removed for item in sublist])\n",
    "\n",
    "removed_df = pd.DataFrame(\n",
    "    removed_counts.items(), columns=[\"feature\", \"times_removed\"]\n",
    ")\n",
    "removed_df = removed_df.sort_values(\n",
    "    by=\"times_removed\", ascending=False\n",
    ").reset_index(drop=True)\n",
    "\n",
    "print(\"\\n===== Most Frequently Removed Features =====\")\n",
    "print(removed_df.head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [],
   "source": [
    "for outlier_method, summary_df in method_summaries.items():\n",
    "    export_path = (\n",
    "        f\"second_model/{outlier_method}_models_summary - Gaussian.png\"\n",
    "    )\n",
    "    model_summary(summary_df, profits, export_path)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [],
   "source": [
    "for outlier_method, summary_df in method_summaries.items():\n",
    "    for summary in reg_model_summaries:\n",
    "        export_path = f\"second_model/{outlier_method}/{summary['score_type']}_{summary['profit']}_residuals.png\"\n",
    "\n",
    "        plot_residual_diagnostics(\n",
