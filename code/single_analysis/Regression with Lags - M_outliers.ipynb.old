{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Regression Models\n",
    "#\n",
    "#### 1st Model: y = ß_0 + ß_1 * score + ß_2_n * dummies + ß_n+1_m * score * dummies"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "# Add the parent directory (code/) to sys.path\n",
    "sys.path.append(str(Path().resolve().parent))\n",
    "from utils import (\n",
    "    load_data,\n",
    "    separate_df_by_scores,\n",
    "    simple_backward_regression,\n",
    "    models_scores_summary,\n",
    "    plot_residual_diagnostics,\n",
    "    gaussian_yj_transform,\n",
    "    simple_backward_gam,\n",
    ")\n",
    "import time\n",
    "import pandas as pd\n",
    "from collections import Counter"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Loading the data\n",
    "#\n",
    "### First we start with basic cleaned data (with outliers)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "file_name = \"Small Data future USA - Multi\"\n",
    "data_path = f\"../data/cleaned/outliers/{file_name}.csv\"\n",
    "\n",
    "# Read the CSV file\n",
    "df = load_data(data_path)\n",
    "df.drop(columns=[\"market_cap\", \"volume\"], inplace=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 1st Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Creating dummy variables\n",
    "df = pd.get_dummies(df, columns=[\"sector\", \"region\"])\n",
    "\n",
    "# Explanatory variables:\n",
    "scores = [\"quality\", \"growth\", \"value\", \"dividend\"]\n",
    "\n",
    "dummies = [col for col in df.columns if col.startswith((\"sector_\", \"region_\"))]\n",
    "# Drop the reference dummy variables (i.e., base categories)\n",
    "reference_dummies = [\n",
    "    \"sector_Information Technology\",\n",
    "    \"region_United States and Canada\",\n",
    "]\n",
    "df.drop(columns=reference_dummies, inplace=True)\n",
    "\n",
    "# Update dummies list after dropping\n",
    "dummies = [col for col in dummies if col not in reference_dummies]\n",
    "\n",
    "# Dependent variables:\n",
    "profits = [\n",
    "    \"profit_1m\",\n",
    "    \"profit_3m\",\n",
    "    \"profit_6m\",\n",
    "    \"profit_1y\",\n",
    "    \"profit_2y\",\n",
    "    \"profit_5y\",\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "dataframes = separate_df_by_scores(df)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Total time: 101.41 seconds\n",
      "Average time per model: 4.23 seconds\n"
     ]
    }
   ],
   "source": [
    "reg_model_summaries = []\n",
    "model_count = 0\n",
    "total_time = 0\n",
    "start_time = time.perf_counter()\n",
    "for score in scores:\n",
    "    score_df = dataframes[score]\n",
    "\n",
    "    # Add interaction terms\n",
    "    for dummy in dummies:\n",
    "        score_df[f\"{score}_{dummy}\"] = score_df[score] * score_df[dummy]\n",
    "\n",
    "    # For each profit, we perform backward elimination\n",
    "    for profit in profits:\n",
    "\n",
    "        X_cols = [score] + dummies + [f\"{score}_{dummy}\" for dummy in dummies]\n",
    "        X = score_df[X_cols].astype(float)\n",
    "        y = score_df[profit].astype(float)\n",
    "\n",
    "        summary = simple_backward_regression(X, y)\n",
    "        summary[\"score_type\"] = score\n",
    "        summary[\"profit\"] = profit\n",
    "\n",
    "        # Collect summary info\n",
    "        reg_model_summaries.append(summary)\n",
    "        model_count += 1\n",
    "\n",
    "end_time = time.perf_counter()\n",
    "total_time = end_time - start_time\n",
    "avg_time = total_time / model_count\n",
    "print(f\"\\nTotal time: {total_time:.2f} seconds\")\n",
    "print(f\"Average time per model: {avg_time:.2f} seconds\")\n",
    "\n",
    "# Create and display summary DataFrame\n",
    "summary_df = pd.DataFrame(reg_model_summaries)\n",
    "summary_df = summary_df.sort_values([\"score_type\"]).reset_index(drop=True)\n",
    "# print(\"\\n===== Summary of All Models =====\")\n",
    "# print(\n",
    "#     summary_df[\n",
    "#         [\"score_type\", \"profit\", \"r2_score\", \"adjusted_r2\", \"n_features\"]\n",
    "#     ]\n",
    "# )"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Analyzing the models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "===== Most Frequently Removed Features =====\n",
      "                               feature  times_removed\n",
      "0                     sector_Materials              6\n",
      "1                 growth_sector_Energy              6\n",
      "2                   sector_Industrials              5\n",
      "3               value_sector_Utilities              5\n",
      "4           dividend_sector_Financials              4\n",
      "5          dividend_sector_Real Estate              4\n",
      "6             value_sector_Industrials              4\n",
      "7        value_sector_Consumer Staples              4\n",
      "8  value_sector_Communication Services              4\n",
      "9            growth_sector_Health Care              3\n"
     ]
    }
   ],
   "source": [
    "all_removed = [\n",
    "    feat\n",
    "    for summary in reg_model_summaries\n",
    "    for feat in summary[\"removed_features\"]\n",
    "]\n",
    "\n",
    "# Count frequency of each removed feature\n",
    "removed_counts = Counter(all_removed)\n",
    "\n",
    "# Convert to DataFrame for easier analysis\n",
    "removed_df = pd.DataFrame(\n",
    "    removed_counts.items(), columns=[\"feature\", \"times_removed\"]\n",
    ")\n",
    "removed_df = removed_df.sort_values(\n",
    "    by=\"times_removed\", ascending=False\n",
    ").reset_index(drop=True)\n",
    "\n",
    "# Display top 10 most dropped features\n",
    "print(\"\\n===== Most Frequently Removed Features =====\")\n",
    "print(removed_df.head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x500 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "export_path = \"first_model/m_outliers_models_summary.png\"\n",
    "\n",
    "models_scores_summary(\n",
    "    summary_df,\n",
    "    profits,\n",
    "    # export_path,\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
