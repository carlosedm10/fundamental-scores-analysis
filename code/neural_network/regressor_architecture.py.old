# Data Prep


#  Imports


import os
import sys
from pathlib import Path
import time
from tqdm import tqdm
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Add the parent directory (code/) to sys.path
sys.path.append(str(Path().resolve().parent))
from utils import (
    load_data,
    separate_df_by_scores,
)
from models import regressor_nn

#  Loading Data


save = True

region = None  # NOTE: If region is None, the model is run for all regions
outlier_method = "IF"
if region:
    file_name = f"Small Data future {region} - {outlier_method}"
else:
    file_name = f"Small Data future - {outlier_method}"

data_path = f"./code/data/cleaned/outliers/{file_name}.csv"

# Read the CSV file
df = load_data(data_path)


#  Prepping the variables


# Creating dummy variables
df = pd.get_dummies(df, columns=["sector", "region"])

# Explanatory variables:
scores = ["quality", "growth", "value", "dividend"]

dummies = [col for col in df.columns if col.startswith(("sector_", "region_"))]

# Drop the reference dummy variables (i.e., base categories)
if not region:
    reference_dummies = [
        "sector_Information Technology",
        "region_Europe",
    ]
else:
    reference_dummies = [
        "sector_Information Technology",
    ]
df.drop(columns=reference_dummies, inplace=True)

# Update dummies list after dropping
dummies = [col for col in dummies if col not in reference_dummies]

# Dependent variables:
profits = [
    "profit_1m",
    "profit_3m",
    "profit_6m",
    "profit_1y",
    "profit_2y",
    "profit_5y",
]
dataframes = separate_df_by_scores(df)


# Regression Neuronal Network


#  Model


# Architecture


hidden_layer_configs = [
    # 1-layer
    (16,),
    (32,),
    (64,),
    (128,),
    (256,),
    (512,),
    # 2-layers
    (64, 32),
    (128, 64),
    (256, 128),
    (512, 256),
    (128, 32),
    (256, 64),
    # 3-layers
    (128, 64, 32),
    (256, 128, 64),
    (512, 256, 128),
    (64, 32, 16),
    (256, 64, 16),
    (128, 64, 8),
    # 4 layers
    (512, 256, 128, 64),
    (256, 128, 64, 32),
    (128, 64, 32, 16),
    (64, 32, 16, 8),
    (1024, 512, 256, 128),
    # Bottleneck
    (256, 64, 16),
    (128, 32, 8),
    (512, 128, 32),
    (1024, 256, 64),
    # Uniform width
    (32, 32),
    (64, 64),
    (128, 128),
    (256, 256),
    (128, 128, 128),
    (256, 256, 256),
]

# To collect all results
all_model_summaries = []
model_count = 0
start_time = time.perf_counter()

print("🔍 Running architecture search across all models...\n")

# Outer loop = each NN config
for hl_config in tqdm(hidden_layer_configs, desc="Hidden Layer Configs"):
    reg_model_summaries = []
    for score in scores:
        score_df = dataframes[score].copy()

        # Rolling features
        avg_cols = []
        std_cols = []
        rolling = {}
        for w in [3, 6, 12, 24]:
            avg_name = f"{score}_avg_{w}m"
            std_name = f"{score}_std_{w}m"

            rolling[avg_name] = score_df.groupby("ticker")[score].transform(
                lambda x: x.rolling(window=w, min_periods=1).mean()
            )
            rolling[std_name] = score_df.groupby("ticker")[score].transform(
                lambda x: x.rolling(window=w, min_periods=1).std()
            )

            avg_cols.append(avg_name)
            std_cols.append(std_name)

        score_df = pd.concat(
            [score_df, pd.DataFrame(rolling, index=score_df.index)], axis=1
        )
        score_df.dropna(inplace=True)

        # Inner loop = each profit target
        for profit in profits:
            X_feats = (
                [score]
                + dummies
                + ["volume", "market_cap"]
                + avg_cols
                + std_cols
            )

            X = pd.concat(
                [
                    score_df[["ticker", "date"]],
                    score_df[X_feats].astype(float),
                ],
                axis=1,
            )
            y = score_df[profit].astype(float)

            try:
                summary = regressor_nn(X, y, hidden_layer_sizes=hl_config)
                summary.update(
                    score_type=score, profit=profit, hidden_layer=hl_config
                )
                reg_model_summaries.append(summary)
                model_count += 1
            except Exception as e:
                print(
                    f"❌ Error with ({score}, {profit}), HL: {hl_config}: {e}"
                )
                continue

    # Save all summaries for this architecture
    all_model_summaries.extend(reg_model_summaries)

# Convert to DataFrame
summary_df = pd.DataFrame(all_model_summaries)

# Show best architectures by average performance
mean_scores_by_arch = (
    summary_df.groupby("hidden_layer")[
        [
            "train_r2_score",
            "train_rmse",
            "train_mae",
            "val_r2_score",
            "val_rmse",
            "val_mae",
            "val_t_r2_score",
            "val_t_rmse",
            "val_t_mae",
        ]
    ]
    .mean()
    .sort_values("train_r2_score", ascending=False)
)

end_time = time.perf_counter()
total_time = end_time - start_time

# Display results
print(
    f"\n✅ Done {model_count} models in {total_time:.2f}s "
    f"({total_time/model_count:.4f}s each)"
)
print("\n🏆 Average scores per architecture (sorted by time-based R²):")
print(mean_scores_by_arch)

# --- Plot all curves in the same image, separated by accuracy and loss ---

# Prepare color palettes
unique_hl = summary_df["hidden_layer"].unique()
n_hl = len(unique_hl)
# Orange for training, green for validation, blue/purple for validation_time
train_palette = sns.color_palette("Oranges", n_colors=n_hl)
val_palette = sns.color_palette("Greens", n_colors=n_hl)
val_t_palette = sns.color_palette("Blues", n_colors=n_hl)

hl_train_color_map = {hl: train_palette[i] for i, hl in enumerate(unique_hl)}
hl_val_color_map = {hl: val_palette[i] for i, hl in enumerate(unique_hl)}
hl_val_t_color_map = {hl: val_t_palette[i] for i, hl in enumerate(unique_hl)}

# Prepare to collect all curves by hidden layer config
loss_curves_by_hl = {hl: [] for hl in unique_hl}
val_curves_by_hl = {hl: [] for hl in unique_hl}
val_t_curves_by_hl = {hl: [] for hl in unique_hl}

for idx, row in summary_df.iterrows():
    hl = row["hidden_layer"]
    model = row.get("model", None)
    # Training loss curve
    loss_curve = getattr(model, "loss_curve_", None)
    # Validation score curve
    val_scores = getattr(model, "validation_scores_", None)
    # Validation_time curve (custom: try to get from summary if available)
    val_t_scores = row.get(
        "val_t_score_curve", None
    )  # You may need to adjust this if you store it differently

    if loss_curve is not None:
        loss_curves_by_hl[hl].append(np.array(loss_curve))
    if val_scores is not None:
        val_curves_by_hl[hl].append(np.array(val_scores))
    if val_t_scores is not None:
        val_t_curves_by_hl[hl].append(np.array(val_t_scores))

# Plot training and validation curves in both images

fig, (ax_loss, ax_acc) = plt.subplots(1, 2, figsize=(18, 7))

# --- LOSS CURVES (left) - Training Loss ---
for hl, curves in loss_curves_by_hl.items():
    if len(curves) == 0:
        continue
    min_len = min([len(c) for c in curves])
    curves_trimmed = [c[:min_len] for c in curves]
    avg_curve = np.mean(curves_trimmed, axis=0)
    color = hl_train_color_map[hl]
    label = f"HL={hl} (training)"
    ax_loss.plot(
        avg_curve, color=color, label=label, linewidth=2, linestyle="-"
    )

ax_loss.set_title("Training Loss Curves by Hidden Layer Config")
ax_loss.set_xlabel("Epoch")
ax_loss.set_ylabel("Loss")
ax_loss.legend(
    title="Hidden Layer Config", bbox_to_anchor=(1.05, 1), loc="upper left"
)
ax_loss.grid(True)

# --- ACCURACY CURVES (right) - Both Training and Validation ---
# Validation accuracy (green)
for hl, curves in val_curves_by_hl.items():
    if len(curves) == 0:
        continue
    min_len = min([len(c) for c in curves])
    curves_trimmed = [c[:min_len] for c in curves]
    avg_curve = np.mean(curves_trimmed, axis=0)
    color = hl_val_color_map[hl]
    label = f"HL={hl} (Val accuracy)"
    ax_acc.plot(
        avg_curve, color=color, label=label, linewidth=2, linestyle="--"
    )

# Validation_time accuracy (blue/purple)
for hl, curves in val_t_curves_by_hl.items():
    if len(curves) == 0:
        continue
    min_len = min([len(c) for c in curves])
    curves_trimmed = [c[:min_len] for c in curves]
    avg_curve = np.mean(curves_trimmed, axis=0)
    color = hl_val_t_color_map[hl]
    label = f"HL={hl} (validation_time accuracy)"
    ax_acc.plot(
        avg_curve, color=color, label=label, linewidth=2, linestyle=":"
    )

ax_acc.set_title(
    "Validation & Validation-Time Accuracy Curves by Hidden Layer Config"
)
ax_acc.set_xlabel("Epoch")
ax_acc.set_ylabel("Accuracy")
ax_acc.legend(
    title="Hidden Layer Config", bbox_to_anchor=(1.05, 1), loc="upper left"
)
ax_acc.grid(True)

plt.tight_layout()
export_path = f"loss_and_accuracy.png"
if save:
    os.makedirs(os.path.dirname(export_path), exist_ok=True)
    plt.savefig(export_path)
    plt.show()
else:
    plt.show()
