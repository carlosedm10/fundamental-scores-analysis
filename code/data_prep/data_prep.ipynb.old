   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from utils import load_data\n",
    "\n",
    "# Get the current file's directory\n",
    "\n",
    "file_name = \"Small Data future 3.0\"\n",
    "data_path = \"../data/raw/Small Data future 3.0.csv\"\n",
    "\n",
    "# Read the CSV file\n",
    "df = load_data(data_path)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cleaning to not have any empty values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(26213, 17)\n",
      "\n",
      "Number of rows dropped: 38952\n",
      "Percentage of data mantained: 40.23%\n",
      "\n",
      "Missing values by column before cleaning:\n",
      "\n",
      "Missing values and percentages by column:\n",
      "quality: 8725 values (13.39%)\n",
      "growth: 35199 values (54.02%)\n",
      "value: 4793 values (7.36%)\n",
      "market_cap_usd: 399 values (0.61%)\n",
      "volume: 399 values (0.61%)\n",
      "profit_1m: 1686 values (2.59%)\n",
      "profit_3m: 2007 values (3.08%)\n",
      "profit_6m: 2109 values (3.24%)\n",
      "profit_1y: 2093 values (3.21%)\n",
      "profit_2y: 2134 values (3.27%)\n",
      "profit_5y: 3876 values (5.95%)\n"
     ]
    }
   ],
   "source": [
    "# Transform date to date format\n",
    "df[\"date\"] = pd.to_datetime(df[\"date\"])\n",
    "# Drop rows with any empty values (NaN)\n",
    "# df[\"growth\"] = df[\"growth\"].fillna(0.0)\n",
    "df[\"dividend\"] = df[\"dividend\"].fillna(0.0)\n",
    "\n",
    "df_no_nan = df.dropna()\n",
    "print(df_no_nan.shape)\n",
    "# Calculate number of dropped rows\n",
    "dropped_rows = df.shape[0] - df_no_nan.shape[0]\n",
    "print(f\"\\nNumber of rows dropped: {dropped_rows}\")\n",
    "print(\n",
    "    f\"Percentage of data mantained: {(df_no_nan.shape[0]/df.shape[0]*100):.2f}%\"\n",
    ")\n",
    "\n",
    "# Display info about which columns had missing values\n",
    "print(\"\\nMissing values by column before cleaning:\")\n",
    "missing_values = df.isnull().sum()\n",
    "missing_values = missing_values[\n",
    "    missing_values > 0\n",
    "]  # Only show columns with missing values\n",
    "missing_percentages = (missing_values / len(df) * 100).round(2)\n",
    "print(\"\\nMissing values and percentages by column:\")\n",
    "for col in missing_values.index:\n",
    "    print(f\"{col}: {missing_values[col]} values ({missing_percentages[col]}%)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Number of stocks with quality score above 80: 0\n",
      "Percentage of stocks with quality score above 80: 0.00%\n"
     ]
    }
   ],
   "source": [
    "# Count values higher than 80 in the quality column\n",
    "quality_above_80 = df_no_nan[df_no_nan[\"quality\"] > 80].shape[0]\n",
    "print(f\"\\nNumber of stocks with quality score above 80: {quality_above_80}\")\n",
    "print(\n",
    "    f\"Percentage of stocks with quality score above 80: {(quality_above_80/df_no_nan.shape[0]*100):.2f}%\"\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Analyzing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "metadata": {},
   "outputs": [
