   ],
   "source": [
    "# Export the cleaned dataset to CSV\n",
    "cleaned_data_path = f\"data/cleaned/{file_name} cleaned.csv\"\n",
    "df_cleaned.to_csv(cleaned_data_path, index=False)\n",
    "\n",
    "print(f\"Cleaned data exported to: {cleaned_data_path}\")"
   ]
  }
